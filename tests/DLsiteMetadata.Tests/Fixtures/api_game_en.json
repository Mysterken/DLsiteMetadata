開放的な空間を意識した、美しいゲーム画面--------------------------------------------------<br />\r\nクリアーで美しい画面は、ゲーム特有のゴチャゴチャ感を極力なくし、プレイヤーが思いっきり走ったり、跳ね<br />\r\nたりできる、自由な空間を目指しました。<br />\r\n<br />\r\n個性豊かなキャラクター達--------------------------------------------------------------------<br />\r\n様々な個性と、技を見せてくれるキャラクター達も必見!!技とタイミングを駆使して突き進め!!<br />\r\n<br />\r\nデモムービーはこちら<br />\r\n<a href=\"http://www.ytg.janis.or.jp/~catwerx/index.html\" target=\"_blank\">http://www.ytg.janis.or.jp/~catwerx/index.html</a>"}]}],"label":null,"notice_list":[],"ranking":[],"bulkbuy_banner":null,"product_banners":[],"work_type_special":"","machine_list":{"pc":"WindowsXP / WindowsVista / Windows7","touch":"","other":"","detail":{"WIN":"WindowsXP / WindowsVista / Windows7","MAC":"","IOS":"","AND":"","IPH":"","IPA":"","IPO":"","other":""}},"system_requirements":{"cpu":"Pentium(R) 4 2.80GHz 相当以上","memory":"実行時に 230MB 使用","hdd":null,"video":null,"mini_resolution":null,"directx":"9.0","etc":"GPU 133MHz 以上"},"page_number":null,"pages":null,"file_size":null,"file_type_special":"","is_split_content":false,"contents_file_size":164145286,"is_oauth_work":false,"translators":null,"work_pack":null,"voice_pack":null,"wishlist_count":38,"dist_flag":1,"editions":[],"language_editions":[],"restricted_conditions":{"allowed_countries":[],"denied_countries":[],"is_display_restricted_by_country":false,"is_region_hidden_relaxable":false,"is_display_restricted_for_guest":false},"reserve_bonus_work":null,"purchase_bonus_works":[],"sales_end_info":null,"trials":[{"extension":"zip","file_size_unit":"198.55MB","url":"//trial.dlsite.com/doujin/RJ105000/RJ104685_trial.zip"}],"trials_touch":[],"movies":[],"urls":{"affiliate_page":"https://www.dlsite.com/home/user/affiliate/link/work/=/product_id/RJ104685.html","play":"https://play.dlsite.com/?workno=RJ104685"},"commercial_translation_info":null}}
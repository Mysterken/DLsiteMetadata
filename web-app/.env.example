# DLsite游戏管理器 - 环境变量配置示例
# 复制此文件为 .env 并修改配置

# Flask密钥（生产环境必须修改！）
SECRET_KEY=your-secret-key-change-this-in-production

# 数据库连接（默认使用SQLite）
# SQLite示例：
DATABASE_URL=sqlite:///dlsite_games.db
# PostgreSQL示例：
# DATABASE_URL=postgresql://username:password@localhost/dlsite_games

# 服务器配置
FLASK_ENV=development
FLASK_DEBUG=True

# 爬虫配置
RATE_LIMIT_CALLS=1
RATE_LIMIT_PERIOD=2
REQUEST_TIMEOUT=10
RETRY_TIMES=3

# 默认语言
DEFAULT_LANGUAGE=zh_CN
